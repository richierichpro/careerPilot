node_modules/
dist/
build/
# The extension is loaded straight from the repo via Chrome's "Load
# unpacked" — no build step should be required to try it, so its built
# output is committed rather than gitignored like every other dist/ dir.
!extension/dist/
!extension/dist/**
.env
.env.local
*.log
.DS_Store
*.sqlite
*.sqlite3
*.tsbuildinfo
server/data/
web/dist/
