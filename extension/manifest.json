{
  "manifest_version": 3,
  "name": "CareerPilot — AI Application Autofill",
  "version": "0.1.0",
  "description": "Fills job applications using your AI-generated Career Profile.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "CareerPilot"
  },
  "background": {
    "service_worker": "dist/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:5173/demo/*",
        "http://localhost:5174/demo/*",
        "http://localhost:5175/demo/*",
        "http://localhost:5176/demo/*"
      ],
      "js": ["dist/content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "http://localhost:8787/*",
    "http://localhost:5173/*",
    "http://localhost:5174/*",
    "http://localhost:5175/*",
    "http://localhost:5176/*"
  ]
}
